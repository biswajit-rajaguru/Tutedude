def cpfile(file1, file2):
    f1 = open(file1, "rt")
    t = f1.read()
    f1.close()
    f2 = open(file2, "xt")
    f2.write(t)
    f2.close()
    print(f"Copied {file1} to {file2}")





cpfile("test-3.txt","test-4.txt")


def head(file, n=10):
    f = open(file, "rt")
    t = ""
    for _ in range(n):
        t += f.readline()
    f.close()
    return t

        




print(f"the head of \"test-3.txt\" {head("test-3.txt")}")


print(f"the head of \"test-3.txt\" {head("test-3.txt",4)}")





def readlinesf(file):
    f = open(file, "rt")
    lines = f.readlines()
    f.close()
    return lines



