# demo of entry widget
import tkinter as tk
from tkinter import font as ft

window = tk.Tk()

window.title("Hello World!")
window.minsize(width = 800, height = 600)

Iosevkaf = ft.Font(family = "Iosevka Comfy Motion", size = 30, slant = "italic", weight = "bold")

#label = tk.Label(text = "Biswajit Rajaguru", font = ("JetBrainsMono Nerd Font Mono", 20, "bold"))
label = tk.Label(text = "Biswajit Rajaguru", font = Iosevkaf)
label.pack(expand = False)
entry1 = tk.Entry(width = 30, font=("Iosevka Comfy Motion",12))
entry1.pack()
entry1.pack()

def retrieve_entry():

    text = entry1.get()
    label.config(text = text)
    entry1.delete(0,tk.END)
    


button = tk.Button(text = "Retrieve", font = Iosevkaf, command = retrieve_entry)
button.pack()
window.mainloop()
print("Bye")


#DEMO of dataobjects in tkinter

import tkinter as tk

# 1. Initialize the main window
root = tk.Tk()
root.title("Mirrored Entries")

# 2. Create the shared Tkinter Variable
# This object will hold the text content for BOTH Entry fields.
shared_text = tk.StringVar()

## --- First Entry (Primary Input) ---
label1 = tk.Label(root, text="Type Here:")
label1.pack(pady=(10, 0))

entry1 = tk.Entry(
    root, 
    width=50, 
    textvariable=shared_text  # Link to the shared variable
)
entry1.pack(padx=20, pady=5)

## --- Second Entry (Mirror) ---
label2 = tk.Label(root, text="Mirrored Text:")
label2.pack(pady=(10, 0))

entry2 = tk.Entry(
    root, 
    width=50, 
    textvariable=shared_text,  # Link to the EXACT SAME variable
    fg="blue"  # Just to show it's a different widget
)
entry2.pack(padx=20, pady=5)

root.mainloop()


# tkinter StringVar demo
from tkinter import ttk as tk
import tkinter

# 1. Initialize the main window
root = tkinter.Tk()
root.title("Mirrored Entries")

# 2. Create the shared Tkinter Variable
# This object will hold the text content for BOTH Entry fields.
shared_text = tkinter.StringVar()

## --- First Entry (Primary Input) ---
label1 = tk.Label(root, text="Type Here:")
label1.pack(pady=(10, 0))

style = tk.Style()
style.configure("Custom.TEntry", foreground = "blue")

entry1 = tk.Entry(
    root, 
    width=50, 
    textvariable=shared_text  # Link to the shared variable
)
entry1.pack(padx=20, pady=5)

## --- Second Entry (Mirror) ---
label2 = tk.Label(root, text="Mirrored Text:")
label2.pack(pady=(10, 0))

    
entry2 = tk.Entry(
    root, 
    width=50, style = "Custom.TEntry",
    textvariable=shared_text,  # Link to the EXACT SAME variable
     # Just to show it's a different widget
)
entry2.pack(padx=20, pady=5)

root.mainloop()


