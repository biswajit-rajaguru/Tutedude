# testing creating multiple toplevel windows
import tkinter as tk
from tkinter import ttk

word = "Biswajit"

root = tk.Tk()
#root.withdraw()

def quit_window(w):
    def quit_window():
        print(f"destroying window: {w.title()}")
        w.destroy()
    return quit_window
    

w = [0]*len(word)
for i in range(len(word)):
    w[i] = tk.Toplevel(root)
    w[i].minsize(width=50,height=50)
    w[i].title(f"#{i}")
    label = tk.Label(w[i], text = word[i], font = ("Iosevka Comfy Motion", 40),bg = "#559999")
    label.pack(expand = True, fill = "both")
    w[i].protocol("WM_DELETE_WINDOW", quit_window(w[i]))
    
root.mainloop()



